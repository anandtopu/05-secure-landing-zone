{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu import:*)",
      "Bash(tofu state rm:*)",
      "Bash(tofu state mv:*)",
      "Bash(tofu force-unlock:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state rm:*)",
      "Bash(terraform state mv:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(aws organizations create-organization:*)",
      "Bash(aws organizations create-account:*)",
      "Bash(aws organizations close-account:*)",
      "Bash(aws organizations move-account:*)",
      "Bash(aws organizations attach-policy:*)",
      "Bash(aws organizations detach-policy:*)",
      "Bash(aws organizations enable-policy-type:*)",
      "Bash(aws organizations register-delegated-administrator:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3api put-object-lock-configuration:*)",
      "Bash(aws kms schedule-key-deletion:*)",
      "Bash(aws ec2 run-instances:*)",
      "Bash(aws iam create-user:*)",
      "Bash(aws iam create-access-key:*)",
      "Bash(git push:*)",
      "PowerShell(tofu apply *)",
      "PowerShell(tofu destroy *)",
      "PowerShell(tofu import *)",
      "PowerShell(tofu state *)",
      "PowerShell(tofu force-unlock *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(terraform import *)",
      "PowerShell(terraform state *)",
      "PowerShell(aws organizations *)",
      "PowerShell(aws s3 rm *)",
      "PowerShell(aws s3 rb *)",
      "PowerShell(aws kms schedule-key-deletion *)",
      "PowerShell(aws ec2 run-instances *)",
      "PowerShell(aws iam create-user *)",
      "PowerShell(aws iam create-access-key *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Bash(aws iam create-access-key --user-name root:*)",
      "Bash(aws configure set aws_secret_access_key:*)",
      "Read(./**/*.tfstate)",
      "Read(~/.aws/credentials)"
    ]
  }
}
